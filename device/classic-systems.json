        "tintG": 1,
        "tintB": 1
      }
    },
    {
      "id": "switch",
      "requiresPackage": "dev.legacy.eden_emulator",
      "builtin": false,
      "enabled": true,
      "displayName": "Nintendo Switch",
      "shortname": "NSW",
      "romDir": "switch",
      "launchType": "custom-package",
      "coreSo": "",
      "package": "dev.legacy.eden_emulator",
      "launchArgs": "",
      "intentTemplate": "-n dev.legacy.eden_emulator/org.yuzu.yuzu_emu.activities.EmulationActivity -a android.intent.action.VIEW -d {file.uri} -t application/octet-stream --activity-clear-task --activity-clear-top",
      "scanSources": [
        {
          "type": "rawpath",
          "value": "/data/media/0/ROMs/switch"
        }
      ],
      "extensions": [
        ".nsp",
        ".xci",
        ".nro",
        ".nso",
