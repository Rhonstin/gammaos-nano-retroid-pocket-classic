    },
    {
      "id": "saturn",
      "requiresCore": "yabasanshiro_libretro_android.so",
      "builtin": false,
      "enabled": true,
      "displayName": "Sega Saturn",
      "shortname": "SAT",
      "romDir": "saturn",
      "launchType": "libretro-core",
      "coreSo": "yabasanshiro_libretro_android.so",
      "package": "",
      "launchArgs": "",
      "intentTemplate": "",
      "scanSources": [
        {
          "type": "rawpath",
          "value": "/data/media/0/ROMs/saturn"
        }
      ],
      "extensions": [
        ".cue",
        ".chd",
        ".ccd",
        ".iso",
        ".mds",
        ".m3u"
      ],
      "icon": {
        "ref": "retroarch:Sega_-_Saturn",
        "tintR": 1,
        "tintG": 1,
        "tintB": 1
      }
    }
  ],
  "migrations": [
    {
      "id": "psx",
      "field": "coreSo",
      "from": "pcsx_rearmed_libretro_android.so",
      "to": "swanstation_libretro_android.so",
      "whenCore": "swanstation_libretro_android.so",
      "whenAnyFile": [
        "/data/media/0/RetroArch/system/scph5501.bin",
        "/data/media/0/RetroArch/system/scph5500.bin",
        "/data/media/0/RetroArch/system/scph5502.bin",
        "/data/media/0/RetroArch/system/scph1001.bin",
        "/data/media/0/RetroArch/system/scph7001.bin",
        "/data/media/0/RetroArch/system/scph101.bin",
        "/data/media/0/RetroArch/system/ps1_rom.bin"
      ]
    }
  ]
}
